# 必填。请填写独立的强随机值；留空时 Compose 会拒绝启动。
MAKERHUB_POSTGRES_PASSWORD=
MAKERHUB_CLOAKBROWSER_AUTH_TOKEN=

# 数据目录。相对路径以 compose.yaml 所在目录为基准。
MAKERHUB_CONFIG_PATH=./data/config
MAKERHUB_ARCHIVE_PATH=./data/archive
MAKERHUB_POSTGRES_DATA_PATH=./data/postgres
MAKERHUB_CLOAKBROWSER_DATA_PATH=./data/cloakbrowser

# MakerHub Web 服务。
MAKERHUB_HTTP_BIND_ADDRESS=0.0.0.0
MAKERHUB_HTTP_PORT=9042
MAKERHUB_WEB_WORKERS=1
MAKERHUB_WORKER_CONCURRENCY=4

# CloakBrowser Manager 默认仅允许宿主机访问。
MAKERHUB_CLOAKBROWSER_BIND_ADDRESS=127.0.0.1
MAKERHUB_CLOAKBROWSER_PORT=9050
MAKERHUB_CLOAKBROWSER_PUBLIC_URL=
MAKERHUB_CLOAKBROWSER_TIMEOUT=30

# 只有反向代理地址明确可控时才填写，多个地址用逗号分隔。
MAKERHUB_TRUSTED_PROXIES=

# Docker 日志轮转。
MAKERHUB_LOG_MAX_SIZE=10m
MAKERHUB_LOG_MAX_FILES=3
TZ=Asia/Shanghai

# 可选：固定或替换镜像。默认使用最新稳定版及已验证的 CloakBrowser digest。
# MAKERHUB_IMAGE=ghcr.io/s450586793/makerhub:latest
# MAKERHUB_POSTGRES_IMAGE=postgres:16-alpine
# MAKERHUB_CLOAKBROWSER_IMAGE=cloakhq/cloakbrowser-manager@sha256:44836e982192e8fedb28617f2d39192bdef91f8dd62cf36c522c96d7d8e15914
