# 必填。请填写独立的强随机值；留空时 Compose 会拒绝启动。
MAKERHUB_POSTGRES_PASSWORD=
MAKERHUB_CLOAKBROWSER_AUTH_TOKEN=

# 其余默认配置已直接写入 compose.yaml，无需复制到这里。
# 仅在远程访问 CloakBrowser Manager 时取消注释并修改下面两项。
# MAKERHUB_CLOAKBROWSER_BIND_ADDRESS=192.168.1.20
# MAKERHUB_CLOAKBROWSER_PUBLIC_URL=http://192.168.1.20:9050

# 仅在反向代理地址明确可控时填写，多个地址用逗号分隔。
# MAKERHUB_TRUSTED_PROXIES=127.0.0.1
