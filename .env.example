# 复制为 .env 后使用。推荐直接运行：python scripts/bootstrap_secrets.py

# 必填：PostgreSQL 与 CloakBrowser 的独立强随机凭据。
MAKERHUB_POSTGRES_PASSWORD=
MAKERHUB_CLOAKBROWSER_AUTH_TOKEN=

# 默认只允许本机访问 MakerHub Web UI。
MAKERHUB_BIND_ADDRESS=127.0.0.1

# 自动视觉验证默认关闭。需要时显式开启；失败仍应人工完成验证。
MAKERHUB_AUTO_VERIFY_3MF=false
TZ=Asia/Shanghai

# MAKERHUB_CLOAKBROWSER_BIND_ADDRESS=192.168.1.20
# MAKERHUB_CLOAKBROWSER_PUBLIC_URL=http://192.168.1.20:9050
